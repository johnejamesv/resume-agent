# Model provider API keys (set at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default model provider: "anthropic" or "openai"
DEFAULT_PROVIDER=anthropic

# Default model IDs
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o

# Set to 1 to force deterministic fallbacks during local testing
DISABLE_LLM=0
